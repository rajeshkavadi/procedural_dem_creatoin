<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dem_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for the simulated drone flight
    and incremental DEM generation pipeline.</description>
  <maintainer email="user@example.com">rajesh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>dem_replay</exec_depend>
  <exec_depend>dem_mapping</exec_depend>
  <exec_depend>dem_viz</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
