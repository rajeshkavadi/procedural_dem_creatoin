<?xml version="1.0"?>
<package format="2">
  <name>dem_viz</name>
  <version>0.1.0</version>
  <description>Live matplotlib heatmap visualisation of the incremental DEM,
    drone trajectory, playback progress and processing statistics.</description>
  <maintainer email="user@example.com">rajesh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>python-numpy</depend>
  <depend>python-matplotlib</depend>

  <test_depend>python-pytest</test_depend>
</package>
