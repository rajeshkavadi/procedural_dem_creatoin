<?xml version="1.0"?>
<package format="2">
  <name>dem_mapping</name>
  <version>0.1.0</version>
  <description>CPU-only incremental elevation-mapping (DEM) node for ROS 1
    Melodic: NumPy elevation grid, modular ground filtering, pose buffering
    and georeferencing helpers.</description>
  <maintainer email="user@example.com">rajesh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>rosbag</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>python-numpy</depend>
  <depend>python-scipy</depend>

  <exec_depend>python-matplotlib</exec_depend>
  <exec_depend>python-gdal</exec_depend>

  <test_depend>python-pytest</test_depend>
</package>
